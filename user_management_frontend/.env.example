# React Frontend Environment Example
# Copy this file to ".env" and adjust values as needed.
# Only variables prefixed with REACT_APP_ are exposed to the browser.

# Base URLs
# Preferred base for the REST API used by the frontend. If set, this takes precedence.
REACT_APP_API_BASE=http://localhost:4000
# Optional: alternative name for the backend URL. Used as a fallback if REACT_APP_API_BASE is not set.
REACT_APP_BACKEND_URL=http://localhost:4000

# Optional: full frontend origin if you are hosting the frontend behind a proxy or different port
REACT_APP_FRONTEND_URL=http://localhost:3000
# Optional: WebSocket URL used by features that need realtime updates
REACT_APP_WS_URL=ws://localhost:4000

# Environment and build toggles
# Explicit environment name (development|production|test). Defaults to NODE_ENV if not provided.
REACT_APP_NODE_ENV=development
# Disable Next.js telemetry if reusing tooling; harmless in CRA context but kept for consistency.
REACT_APP_NEXT_TELEMETRY_DISABLED=1
# Generate source maps in production builds (true|false). Useful for debugging.
REACT_APP_ENABLE_SOURCE_MAPS=true
# Port used by the CRA dev server (npm start). Typically 3000.
REACT_APP_PORT=3000
# If running behind a proxy/load balancer and you need trust proxy semantics for dev middleware.
REACT_APP_TRUST_PROXY=false
# Logging level for client code using config.getLogLevel() (debug|info|warn|error).
REACT_APP_LOG_LEVEL=info

# Healthcheck
# Path that client code may use to probe health endpoints on the API or self.
REACT_APP_HEALTHCHECK_PATH=/health

# Feature flags
# Accepts JSON or CSV formats:
# JSON: {"enableBulkActions": true, "newNav": false}
# CSV:  enableBulkActions,newNav=false
REACT_APP_FEATURE_FLAGS={"enableBulkActions": false}
# Enables experimental UI/behavior toggles globally (true|false).
REACT_APP_EXPERIMENTS_ENABLED=false
